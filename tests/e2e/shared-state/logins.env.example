# Copy to logins.env in this folder and fill in values.
# logins.env is gitignored. This example is safe to commit.
# Key names match tests/e2e/auth0-personas.json. Passwords stay in logins.env.

DERTINFO_E2E_EVENT_ADMIN_EMAIL=
DERTINFO_E2E_EVENT_ADMIN_PASSWORD=

DERTINFO_E2E_VENUE_ADMIN_EMAIL=
DERTINFO_E2E_VENUE_ADMIN_PASSWORD=

DERTINFO_E2E_GROUP_ADMIN_EMAIL=
DERTINFO_E2E_GROUP_ADMIN_PASSWORD=

DERTINFO_E2E_GROUP_ADMIN_2_EMAIL=
DERTINFO_E2E_GROUP_ADMIN_2_PASSWORD=

DERTINFO_E2E_GROUP_MEMBER_EMAIL=
DERTINFO_E2E_GROUP_MEMBER_PASSWORD=
