{
    // Name this configuration
    "name": "Codespace For DertInfo App",
    // Use the base codespace image
    "image": "mcr.microsoft.com/vscode/devcontainers/universal:latest",
    "remoteUser": "codespace",
    "overrideCommand": false,
    // Add the IDs of extensions you want installed when the container is created.
    "customizations": {
      "vscode": {
        "extensions": [
          "ms-azuretools.vscode-azurestaticwebapps",
          "ms-azuretools.vscode-docker",
          "ms-mssql.mssql",
          "github.copilot"
        ]
      }
    },
    "postCreateCommand": "npm install -g typescript @azure/static-web-apps-cli @angular/cli@13 && sh .devcontainer/setup-codespace.sh",
    "forwardPorts": [44100,44300],
    "portsAttributes": {
      "44100": {
        "label": "Public Availability On Api",
        "onAutoForward": "notify",
        "visibility": "public"
      },
      "44300": {
        "label": "Public Availability On App",
        "onAutoForward": "notify",
        "visibility": "public"
      }
    }
  }
